!pain-frontend/
!pain-frontend/**
!pain-server/
!pain-server/**
!pain-setup/
!pain-setup/db-config.env
**/node_modules
**/dist
**/.git
**/.offline
**/offline-release
**/.cursor
**/.env
**/.env.*
**/*.log
